#!/usr/bin/env node

const { spawnSync } = require('node:child_process')
const path = require('node:path')

const projectRoot = path.resolve(__dirname, '..')
const viteNode = path.join(projectRoot, 'node_modules', 'vite-node', 'vite-node.mjs')
const entryPoint = path.join(projectRoot, 'src', 'cli', 'xingularity.ts')
const result = spawnSync(process.execPath, [viteNode, entryPoint, ...process.argv.slice(2)], {
  cwd: projectRoot,
  stdio: 'inherit'
})

if (result.error) {
  console.error(`Unable to start Xingularity CLI: ${result.error.message}`)
  process.exitCode = 1
} else if (typeof result.status === 'number') {
  process.exitCode = result.status
} else {
  process.exitCode = 1
}
